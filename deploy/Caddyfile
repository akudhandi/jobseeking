{
	email {$ACME_EMAIL:admin@example.com}
}

{$APP_DOMAIN} {
	encode gzip

	# Everything is behind HTTP basic auth (private dashboard).
	basic_auth {
		{$BASIC_AUTH_USER} {$AUTH_HASH}
	}

	# API under /api/* — prefix stripped before hitting the backend.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Dashboard.
	handle {
		reverse_proxy web:3000
	}
}

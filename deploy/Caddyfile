# Origin behind the Cloudflare Tunnel (cf-tunnel on this box).
# TLS and access control are handled at Cloudflare (Access + OTP), so Caddy
# listens on plain HTTP and compose publishes it on 127.0.0.1:18080, which the
# tunnel's public hostname points at.
#
# 8080 is already taken by the "keepalive" pm2 process — do not reuse it.
:80 {
	encode gzip

	# Fallback auth if Cloudflare Access is ever disabled. Uncomment together
	# with BASIC_AUTH_USER / AUTH_HASH in .env.prod.
	# basic_auth {
	#	{$BASIC_AUTH_USER:admin} {$AUTH_HASH}
	# }

	# API under /api/* — prefix stripped before hitting the backend.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Dashboard.
	handle {
		reverse_proxy web:3000
	}
}

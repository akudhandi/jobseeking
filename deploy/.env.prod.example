# Production config — copy to ../.env.prod (repo root) and fill in.
#   cp deploy/.env.prod.example .env.prod
#   chmod 600 .env.prod
# Never commit .env.prod.
#
# TLS and access control are handled by Cloudflare (Access + OTP) in front of
# the Cloudflare Tunnel. There is no ACME, no public port, no domain setting here.

# --- Postgres ---
POSTGRES_USER=jobseeking
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=jobseeking

# --- CORS (same-origin via /api, so this is just belt-and-braces) ---
CORS_ORIGINS=https://jobs.sengganglabs.my.id

# --- Residential proxy (either inline list or the mounted secrets/proxies.txt) ---
PROXY_URLS=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- CapSolver ---
CAPSOLVER_API_KEY=

# --- Scraper tuning ---
HEADLESS=true
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=4.0
SCRAPE_MAX_RETRIES=3

# --- Optional: Caddy basic auth fallback (only if Cloudflare Access is off) ---
# BASIC_AUTH_USER=admin
# AUTH_HASH=

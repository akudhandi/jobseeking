FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src \
    CONFIG_PATH=/app/config.yaml \
    DATA_DIR=/app/data

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
RUN pip install .

COPY config.yaml ./

EXPOSE 8000

# Create tables (idempotent) then serve the read API.
CMD ["sh", "-c", "python -m jobseeking.pipeline --init-db && uvicorn jobseeking.api.main:app --host 0.0.0.0 --port 8000"]

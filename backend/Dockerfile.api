FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src \
    CONFIG_PATH=/app/config.yaml \
    DATA_DIR=/app/data

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
RUN pip install .

COPY config.yaml ./
# Alembic config + migrations live next to the package: the container applies
# pending revisions on start (`python -m jobseeking.pipeline --init-db`).
COPY alembic.ini ./
COPY migrations ./migrations

EXPOSE 8000

# Apply pending migrations, then serve the read API.
CMD ["sh", "-c", "python -m jobseeking.pipeline --init-db && uvicorn jobseeking.api.main:app --host 0.0.0.0 --port 8000"]

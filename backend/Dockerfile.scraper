FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src \
    CONFIG_PATH=/app/config.yaml \
    DATA_DIR=/app/data

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
RUN pip install . \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

COPY config.yaml ./

# Raw HTML + exports live on a mounted volume so they survive rebuilds.
VOLUME ["/app/data"]

ENTRYPOINT ["python", "-m", "jobseeking.pipeline"]
CMD ["--help"]

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src \
    CONFIG_PATH=/app/config.yaml \
    DATA_DIR=/app/data

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
# libatomic1 is required by playwright's bundled node driver *before*
# `playwright install --with-deps` can run (newer playwright versions fail with
# "error while loading shared libraries: libatomic.so.1" otherwise).
RUN pip install . \
    && apt-get update \
    && apt-get install -y --no-install-recommends libatomic1 \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

COPY config.yaml ./
# Alembic config + migrations: the scraper applies pending revisions on start.
COPY alembic.ini ./
COPY migrations ./migrations

# Raw HTML + exports live on a mounted volume so they survive rebuilds.
VOLUME ["/app/data"]

ENTRYPOINT ["python", "-m", "jobseeking.pipeline"]
CMD ["--help"]

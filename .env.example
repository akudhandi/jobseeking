# --- Database (match docker-compose.yml) ---
POSTGRES_USER=jobseeking
POSTGRES_PASSWORD=jobseeking
POSTGRES_DB=jobseeking
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://jobseeking:jobseeking@localhost:5432/jobseeking

# --- Residential proxy ---
# Comma-separated list. Each entry either:
#   http://user:pass@host:port
#   host:port  (credentials taken from PROXY_USERNAME/PROXY_PASSWORD)
PROXY_URLS=
PROXY_USERNAME=
PROXY_PASSWORD=
# Optional: path (repo-relative or absolute) to a gitignored file of proxies.
# One per line: host:port:user:pass   or   http://user:pass@host:port
PROXY_FILE=

# --- CapSolver ---
CAPSOLVER_API_KEY=

# --- Scraper behavior ---
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=4.0
SCRAPE_MAX_RETRIES=3
SCRAPE_TIMEOUT_MS=45000
HEADLESS=true

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# pgAdmin (optional, profile: tools)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
